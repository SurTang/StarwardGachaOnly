<?xml version="1.0" encoding="utf-8" ?>
<!--  GachaOnly fork: the card that is rendered into the exported PNG.
      Layout: one header, one column per banner (side by side), one footer — so the whole record set
      fits in a single render and there are no page seams. Light themed and self-contained on
      purpose, so the exported image looks the same whatever theme the app runs in.  -->
<UserControl x:Class="Starward.Features.Gacha.GachaExportCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="1600"
             HorizontalAlignment="Left"
             mc:Ignorable="d">

    <Border x:Name="Border_Root"
            Padding="28"
            Background="#FFF7F8FB"
            BorderBrush="#FFE4E7EE"
            BorderThickness="1"
            CornerRadius="4">
        <StackPanel Spacing="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TextBlock_Title"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#FF151A23"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="TextBlock_Subtitle"
                               FontSize="12.5"
                               Foreground="#FF6B7280"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Image x:Name="Image_GameIcon"
                       Grid.Column="1"
                       Width="46"
                       Height="46"
                       VerticalAlignment="Top"
                       Stretch="UniformToFill" />
            </Grid>

            <Grid x:Name="Grid_Body" ColumnSpacing="16" />

            <TextBlock x:Name="TextBlock_Footer"
                       Margin="0,2,0,0"
                       FontSize="11"
                       Foreground="#FF9AA1AC" />

        </StackPanel>
    </Border>

</UserControl>
