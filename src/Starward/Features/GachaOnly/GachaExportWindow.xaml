<?xml version="1.0" encoding="utf-8" ?>
<!--  GachaOnly fork: preview + export window for the "records as image" feature.  -->
<sf:WindowEx x:Class="Starward.Features.Gacha.GachaExportWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.Gacha"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             mc:Ignorable="d">

    <Grid x:Name="Grid_Root"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Loaded="Grid_Root_Loaded">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TextBlock_Header"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">
                <ProgressRing x:Name="ProgressRing_Busy"
                              Width="18"
                              Height="18"
                              IsActive="True" />
                <TextBlock x:Name="TextBlock_Status"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="Button_Save"
                        Click="Button_Save_Click" />
                <Button x:Name="Button_Copy"
                        Click="Button_Copy_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ScrollViewer_Card"
                      Grid.Row="1"
                      Padding="0,0,0,16"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto">
            <local:GachaExportCard x:Name="Card"
                                   Margin="16,0,16,0"
                                   HorizontalAlignment="Left" />
        </ScrollViewer>

    </Grid>

</sf:WindowEx>
