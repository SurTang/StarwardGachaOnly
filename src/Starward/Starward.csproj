<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<LangVersion>preview</LangVersion>
		<RootNamespace>Starward</RootNamespace>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationIcon>../logo.ico</ApplicationIcon>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<CsWinRTAotOptimizerEnabled Condition="'$(Configuration)' == 'Debug'">false</CsWinRTAotOptimizerEnabled>
		<CsWinRTAotOptimizerEnabled Condition="'$(Configuration)' != 'Debug'">true</CsWinRTAotOptimizerEnabled>
		<CETCompat>false</CETCompat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
		<!--  DO NOT Update Segmented https://github.com/CommunityToolkit/Windows/pull/699  -->
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.250402" />
		<PackageReference Include="CommunityToolkit.WinUI.Helpers" Version="8.2.251219" />
		<PackageReference Include="ComputeSharp.D2D1.WinUI" Version="3.2.0" />
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="H.InputSimulator" Version="1.5.0" />
		<PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.11" />
		<PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
		<PackageReference Include="MiniExcel" Version="1.46.0" />
		<PackageReference Include="NuGet.Versioning" Version="7.9.0" />
		<PackageReference Include="Scighost.WinUI" Version="0.1.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Starward.Assets" Version="0.6.5" />
		<PackageReference Include="Starward.Codec" Version="0.5.2" />
		<PackageReference Include="Starward.GameInput" Version="0.3.1" />
		<PackageReference Include="Starward.NativeLib" Version="0.3.1" />
		<PackageReference Include="Starward.Win2D" Version="1.3.2-release.1" />
		<PackageReference Include="System.IO.Hashing" Version="10.0.11" />
		<PackageReference Include="Vanara.PInvoke.DwmApi" Version="5.0.7" />
		<PackageReference Include="Vanara.PInvoke.Ole" Version="5.0.7" />
		<PackageReference Include="Vanara.PInvoke.SetupAPI" Version="5.0.7" />
		<PackageReference Include="Vanara.PInvoke.Shell32" Version="5.0.7" />
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Starward.Core\Starward.Core.csproj" />
		<ProjectReference Include="..\Starward.Language\Starward.Language.csproj" />
		<ProjectReference Include="..\Starward.RPC\Starward.RPC.csproj" />
		<ProjectReference Include="..\Starward.Setup.Core\Starward.Setup.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="Assets\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<Target Name="RemoveDlls" AfterTargets="Publish">
		<Delete Files="$(PublishDir)DirectML.dll" />
		<Delete Files="$(PublishDir)onnxruntime.dll" />
	</Target>

	<!-- =================================================================== -->
	<!-- GachaOnly fork: isolated customization block.                       -->
	<!-- Nothing above this line is modified, so upstream edits to this file -->
	<!-- keep merging cleanly. Build the standalone gacha app with:          -->
	<!--   dotnet publish src/Starward -c Release -r win-x64 -p:Platform=x64 -->
	<!--                  -p:GachaOnly=true -p:Version=<ver>                 -->
	<!-- Build stock Starward from the same tree with -p:GachaOnly=false.    -->
	<!-- =================================================================== -->
	<PropertyGroup>
		<GachaOnly Condition="'$(GachaOnly)' == ''">true</GachaOnly>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GachaOnly)' == 'true'">
		<!-- Named Starward.exe, not Starward.GachaOnly.exe: both the portable launcher in this fork and
		     upstream's own C++ launcher (built by .github/workflows/build.yml) start
		     app-<version>\Starward.exe, so the standard CI workflow produces a working package with no
		     changes at all. -->
		<AssemblyName>Starward</AssemblyName>
		<Product>Starward Gacha</Product>
	</PropertyGroup>

	<!-- The gacha switch is a *generated compile time constant*, not a DefineConstants entry and not a
	     reflected attribute:
	       * a command line -p:DefineConstants=... is a global MSBuild property and silently wins over
	         anything this file appends (upstream CI passes -p:DefineConstants=DONOT_CHECK_UPDATE), which
	         used to drop the constant and quietly produce stock Starward branded as the gacha app;
	       * an AssemblyMetadata attribute would work, but it can only be read through reflection, and
	         the Release publish trims the app.
	     A generated const is immune to both. See GachaOnlyProfile.Enabled / GachaOnlyMarker. -->
	<!-- BeforeBuild (and the later compile steps, for direct -t:CoreCompile style invocations): the file
	     has to exist before WinUI's MarkupCompilePass2 compiles the project to resolve local XAML types,
	     not just before the final C# compile. -->
	<Target Name="GenerateGachaOnlyMarker" BeforeTargets="BeforeBuild;MarkupCompilePass1;MarkupCompilePass2;BeforeCompile;CoreCompile">
		<PropertyGroup>
			<_GachaOnlyMarkerFile>$(IntermediateOutputPath)GachaOnlyMarker.g.cs</_GachaOnlyMarkerFile>
			<_GachaOnlyMarkerValue Condition="'$(GachaOnly)' == 'true'">true</_GachaOnlyMarkerValue>
			<_GachaOnlyMarkerValue Condition="'$(GachaOnly)' != 'true'">false</_GachaOnlyMarkerValue>
		</PropertyGroup>
		<!-- the %3B is a literal semicolon: an unescaped one would split the Lines item list -->
		<WriteLinesToFile File="$(_GachaOnlyMarkerFile)"
		                  Overwrite="true"
		                  WriteOnlyWhenDifferent="true"
		                  Lines="// auto-generated by Starward.csproj (GachaOnly fork), do not edit;namespace Starward.Features.Gacha { internal static class GachaOnlyMarker { internal const bool Enabled = $(_GachaOnlyMarkerValue)%3B } }" />
		<ItemGroup>
			<Compile Include="$(_GachaOnlyMarkerFile)" Visible="false" />
		</ItemGroup>
	</Target>

	<!-- Machine capability, not a fork feature: these apply to every build of this tree (stock too),
	     so a bare machine can build both variants. -->
	<PropertyGroup>
		<!-- The CsWinRT projection and AOT optimizer steps need the Windows SDK (windows.winmd). On a
		     machine that has it (the GitHub windows runner, a dev box with VS) upstream's Release
		     configuration is left untouched — projection on, trimming on, AOT optimizer on — which is
		     the combination upstream ships. On a bare machine the safe path below is used instead.
		     Override explicitly with -p:WindowsSdkAvailable=true|false. -->
		<WindowsSdkAvailable Condition="'$(WindowsSdkAvailable)' == '' and Exists('$(WindowsSdkDir)UnionMetadata\Windows.winmd')">true</WindowsSdkAvailable>
		<WindowsSdkAvailable Condition="'$(WindowsSdkAvailable)' == ''">false</WindowsSdkAvailable>

		<!-- Without the SDK, disable every step that needs it. Trimming and ReadyToRun must go together
		     with the CsWinRT AOT optimizer: a trimmed build without it dies at XAML startup with
		     0xC000027B. -->
		<CsWinRTGenerateProjection Condition="'$(WindowsSdkAvailable)' != 'true'">false</CsWinRTGenerateProjection>
		<CsWinRTAotOptimizerEnabled Condition="'$(WindowsSdkAvailable)' != 'true'">false</CsWinRTAotOptimizerEnabled>
		<!-- The publish profile (Properties/PublishProfiles/win-$(Platform).pubxml, selected by line 13
		     above) is imported *after* this file and would put PublishTrimmed/PublishReadyToRun back to
		     true, so it has to be deselected rather than overridden. SelfContained comes from the same
		     profile, hence the explicit value here. -->
		<PublishProfile Condition="'$(WindowsSdkAvailable)' != 'true'"></PublishProfile>
		<SelfContained Condition="'$(WindowsSdkAvailable)' != 'true' and '$(SelfContained)' == ''">true</SelfContained>
		<PublishTrimmed Condition="'$(WindowsSdkAvailable)' != 'true'">false</PublishTrimmed>
		<PublishReadyToRun Condition="'$(WindowsSdkAvailable)' != 'true'">false</PublishReadyToRun>
	</PropertyGroup>
	<!-- ==================== end GachaOnly customization =================== -->

</Project>
