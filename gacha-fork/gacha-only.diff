@@ -0,0 +1,263 @@
+// GachaOnly fork — preview + PNG export window for the current game / current account.
+//
+// The card is rendered with RenderTargetBitmap at 2x so text and icons stay crisp. Because a
+// ScrollViewer clips its content, the window is temporarily enlarged to the full card size before
+// rendering (otherwise a tall card would be cut off at the viewport edge).
+//
+// This file is new in the fork; upstream never touches it.
+
+using Microsoft.Extensions.Logging;
+using Microsoft.UI.Xaml;
+using Microsoft.UI.Xaml.Media.Imaging;
+using Starward.Core;
+using Starward.Frameworks;
+using Starward.Helpers;
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+using Windows.ApplicationModel.DataTransfer;
+using Windows.Graphics;
+using Windows.Graphics.Imaging;
+using Windows.Storage;
+using Windows.Storage.Streams;
+using Windows.System;
+
+namespace Starward.Features.Gacha;
+
+public sealed partial class GachaExportWindow : WindowEx
+{
+
+    private const double RenderScale = 2.0;
+
+    /// <summary>RenderTargetBitmap refuses to render anything larger than this in one dimension.</summary>
+    private const double MaxRenderPixels = 4000;
+
+
+    private readonly ILogger<GachaExportWindow> _logger = AppConfig.GetLogger<GachaExportWindow>();
+
+    private readonly GameBiz _biz;
+
+    private long _uid;
+
+    private GachaExportModel? _model;
+
+    private readonly GachaExportMode _mode;
+
+
+    internal GachaExportWindow(GameBiz biz, long uid, GachaExportMode mode = GachaExportMode.Records)
+    {
+        this.InitializeComponent();
+        _biz = biz;
+        _mode = mode;
+        _uid = uid > 0 ? uid : GachaExportModelBuilder.GetLastUid(biz);
+        GachaExportStrings s = GachaExportStrings.Current;
+        string what = mode == GachaExportMode.Counts ? s.CountsRecords : s.Records;
+        Title = $"{GachaExportModelBuilder.GetGameName(biz)} · {what}";
+        Button_Save.Content = s.SaveAsPng;
+        Button_Copy.Content = s.CopyImage;
+        TextBlock_Status.Text = s.Generating;
+        CenterInScreen(1240, 900);
+    }
+
+
+    /// <summary>Current game, or null when the caller did not resolve one yet.</summary>
+    public GameBiz GameBiz => _biz;
+
+
+    public long Uid => _uid;
+
+
+    private async void Grid_Root_Loaded(object sender, RoutedEventArgs e)
+    {
+        try
+        {
+            GachaExportStrings s = GachaExportStrings.Current;
+            _model = _mode == GachaExportMode.Counts
+                ? await GachaExportModelBuilder.BuildCountsAsync(_biz, _uid)
+                : await GachaExportModelBuilder.BuildAsync(_biz, _uid);
+            if (_model is null)
+            {
+                TextBlock_Status.Text = s.NoRecords;
+                if (_autoExportPath is not null)
+                {
+                    _logger.LogError("No gacha records to export for {Biz} uid {Uid}", _biz.Value, _uid);
+                    Environment.Exit(1);
+                }
+                return;
+            }
+            Card.SetModel(_model);
+            TextBlock_Header.Text = _model.Title;
+            await Task.Delay(250); // let the images and the layout settle
+            ProgressRing_Busy.IsActive = false;
+            ProgressRing_Busy.Visibility = Visibility.Collapsed;
+            TextBlock_Status.Text = _model.Subtitle;
+            Button_Save.IsEnabled = true;
+            Button_Copy.IsEnabled = true;
+            if (_autoExportPath is not null)
+            {
+                await ExportAndExitAsync();
+            }
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError(ex, "Build gacha export model");
+            ProgressRing_Busy.IsActive = false;
+            TextBlock_Status.Text = ex.Message;
+        }
+    }
+
+
+    private async Task ExportAndExitAsync()
+    {
+        bool ok = await ExportToFileAsync(_autoExportPath!);
+        Environment.Exit(ok ? 0 : 1);
+    }
+
+
+    private string? _autoExportPath;
+
+
+    /// <summary>Set by the command line export path; when set the window exports and exits by itself.</summary>
+    public void SetAutoExport(string path)
+    {
+        _autoExportPath = path;
+        Button_Save.IsEnabled = true;
+        Button_Copy.IsEnabled = true;
+    }
+
+
+    private async void Button_Save_Click(object sender, RoutedEventArgs e)
+    {
+        try
+        {
+            if (_model is null)
+            {
+                return;
+            }
+            GachaExportStrings s = GachaExportStrings.Current;
+            string suggestName = _mode == GachaExportMode.Counts
+                ? $"Starward_GachaCount_{_biz.Game}_{_uid}_{DateTime.Now:yyyyMMddHHmmss}.png"
+                : $"Starward_Gacha_{_biz.Game}_{_uid}_{DateTime.Now:yyyyMMddHHmmss}.png";
+            string? path = await FileDialogHelper.OpenSaveFileDialogAsync(Content.XamlRoot, suggestName, ("PNG", ".png"));
+            if (string.IsNullOrWhiteSpace(path))
+            {
+                return;
+            }
+            TextBlock_Status.Text = s.Generating;
+            if (await ExportToFileAsync(path))
+            {
+                TextBlock_Status.Text = s.SavedTo + " " + path;
+                StorageFile storageFile = await StorageFile.GetFileFromPathAsync(path);
+                var options = new FolderLauncherOptions();
+                options.ItemsToSelect.Add(storageFile);
+                await Launcher.LaunchFolderAsync(await storageFile.GetParentAsync(), options);
+            }
+            else
+            {
+                TextBlock_Status.Text = s.ExportFailed;
+            }
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError(ex, "Save gacha image");
+            TextBlock_Status.Text = ex.Message;
+        }
+    }
+
+
+    private async void Button_Copy_Click(object sender, RoutedEventArgs e)
+    {
+        try
+        {
+            if (_model is null)
+            {
+                return;
+            }
+            string file = Path.Combine(Path.GetTempPath(), $"Starward_Gacha_{_biz.Game}_{_uid}.png");
+            if (await ExportToFileAsync(file))
+            {
+                StorageFile storageFile = await StorageFile.GetFileFromPathAsync(file);
+                ClipboardHelper.SetStorageItems(DataPackageOperation.Copy, new[] { storageFile });
+                TextBlock_Status.Text = GachaExportStrings.Current.Copied;
+            }
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError(ex, "Copy gacha image");
+            TextBlock_Status.Text = ex.Message;
+        }
+    }
+
+
+    /// <summary>
+    /// Renders the card in one pass and writes it as a PNG file.
+    /// RenderTargetBitmap is capped at 4096 px per dimension, so if the card is taller than that the
+    /// whole card is scaled down just enough to fit — the layout is column based, which keeps that
+    /// from happening for normal record sets, and unlike page stitching it never leaves a seam.
+    /// Also used by the command line export.
+    /// </summary>
+    public async Task<bool> ExportToFileAsync(string path)
+    {
+        try
+        {
+            if (_model is null)
+            {
+                return false;
+            }
+
+            Card.SetModel(_model);
+            Card.UpdateLayout();
+            await Task.Delay(220); // let the icons and the layout settle
+            _logger.LogInformation("[GachaExport] {Layout}", Card.DescribeLayout());
+
+            double cardWidth = Card.CardWidth;
+            double cardHeight = Card.ActualHeight;
+            if (cardWidth < 10 || cardHeight < 10)
+            {
+                return false;
+            }
+            double scale = Math.Clamp(MaxRenderPixels / cardHeight, 0.5, RenderScale);
+
+            var bitmap = new RenderTargetBitmap();
+            await bitmap.RenderAsync(Card, (int)Math.Round(cardWidth * scale), (int)Math.Round(cardHeight * scale));
+            byte[] pixels = await ReadPixelsAsync(bitmap);
+
+            string? folder = Path.GetDirectoryName(path);
+            if (!string.IsNullOrWhiteSpace(folder))
+            {
+                Directory.CreateDirectory(folder);
+            }
+            // a plain FileStream works for the save picker (file already created) and for the
+            // command line export (file does not exist yet)
+            using (var fileStream = new FileStream(path, FileMode.Create, FileAccess.ReadWrite, FileShare.None))
+            using (IRandomAccessStream stream = fileStream.AsRandomAccessStream())
+            {
+                BitmapEncoder encoder = await BitmapEncoder.CreateAsync(BitmapEncoder.PngEncoderId, stream);
+                encoder.SetPixelData(BitmapPixelFormat.Bgra8, BitmapAlphaMode.Premultiplied,
+                                     (uint)bitmap.PixelWidth, (uint)bitmap.PixelHeight, 96, 96, pixels);
+                await encoder.FlushAsync();
+            }
+            _logger.LogInformation("Gacha image exported to {Path} ({Width}x{Height}, layout {CardW}x{CardH}, scale {Scale:F2})",
+                                   path, bitmap.PixelWidth, bitmap.PixelHeight, cardWidth, cardHeight, scale);
+            return true;
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError(ex, "Export gacha image to {Path}", path);
+            return false;
+        }
+    }
+
+
+    private static async Task<byte[]> ReadPixelsAsync(RenderTargetBitmap bitmap)
+    {
+        IBuffer buffer = await bitmap.GetPixelsAsync();
+        byte[] pixels = new byte[buffer.Length];
+        using var reader = DataReader.FromBuffer(buffer);
+        reader.ReadBytes(pixels);
+        return pixels;
+    }
+
+}
diff --git a/src/Starward/Features/GachaOnly/GachaOnlyDataFolder.cs b/src/Starward/Features/GachaOnly/GachaOnlyDataFolder.cs
new file mode 100644
index 0000000..ade9613
--- /dev/null
+++ b/src/Starward/Features/GachaOnly/GachaOnlyDataFolder.cs
@@ -0,0 +1,291 @@
+// GachaOnly fork — resolves the user data folder that holds StarwardDatabase.db.
+//
+// Requirement for this fork: the standalone gacha app must reuse the data folder of the user's
+// existing Starward install ("共用同一个数据目录"), so gacha records, UIGF archives and the
+// cached gacha URLs are shared with it instead of being duplicated.
+//
+// Resolution order (first hit wins):
+//   1. command line :  --data-folder <path>   or  --data-folder=<path>
+//   2. environment  :  STARWARD_GACHA_DATA_FOLDER
+//   3. gacha-data.ini next to the executable, key UserDataFolder=<path>
+//   4. auto probe   : known Starward-family folders on this machine (see ProbeCandidates)
+//   5. null         : fall back to upstream Starward resolution (registry / portable config.ini /
+//                     first-run welcome dialog)
+//
+// Everything is validated: a candidate that does not exist (or, for the auto probe, has no
+// database) is skipped, so a stale ini file can never leave the app without a database.
+//
+// This file is new in the fork; upstream never touches it.
+
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+
+namespace Starward.Features.Gacha;
+
+internal static class GachaOnlyDataFolder
+{
+
+    /// <summary>Config file next to the executable. Key name matches upstream's portable config.ini.</summary>
+    public const string ConfigFileName = "gacha-data.ini";
+
+    public const string EnvironmentVariable = "STARWARD_GACHA_DATA_FOLDER";
+
+    public const string UserDataFolderKey = "UserDataFolder";
+
+    public const string CommandLineOption = "--data-folder";
+
+    public const string DatabaseFileName = "StarwardDatabase.db";
+
+
+    private const string LogFileName = "GachaOnly-data-folder.log";
+
+
+    private static bool _resolved;
+
+    private static string? _folder;
+
+
+    /// <summary>The folder that was accepted this run, or null when upstream resolution is used.</summary>
+    public static string? ResolvedFolder => _folder;
+
+
+    /// <summary>Where the accepted folder came from, for the breadcrumb log.</summary>
+    public static string? ResolvedFrom { get; private set; }
+
+
+    /// <summary>
+    /// Returns the shared data folder, or null when the fork does not apply / nothing was configured.
+    /// Called once per process from <c>AppConfig.CheckEnviromentAsync</c>.
+    /// </summary>
+    public static string? Resolve()
+    {
+        if (!GachaOnlyProfile.Enabled)
+        {
+            return null;
+        }
+        if (_resolved)
+        {
+            return _folder;
+        }
+        _resolved = true;
+
+        var tried = new List<string>();
+        foreach ((string? candidate, string source) in Sources())
+        {
+            if (string.IsNullOrWhiteSpace(candidate))
+            {
+                continue;
+            }
+            string path = Normalize(candidate);
+            tried.Add($"{source} => {path}");
+            if (!Directory.Exists(path))
+            {
+                continue;
+            }
+            if (!File.Exists(Path.Combine(path, DatabaseFileName)) && source.StartsWith("probe", StringComparison.Ordinal))
+            {
+                // An explicitly configured folder may legitimately be brand new (upstream creates the
+                // database on first use), but a probe result without a database is useless.
+                continue;
+            }
+            _folder = path;
+            ResolvedFrom = source;
+            WriteBreadcrumb(tried, path, source);
+            return path;
+        }
+
+        WriteBreadcrumb(tried, null, null);
+        return null;
+    }
+
+
+    private static IEnumerable<(string? Candidate, string Source)> Sources()
+    {
+        string[] args = Environment.GetCommandLineArgs();
+        for (int i = 0; i < args.Length; i++)
+        {
+            string arg = args[i];
+            if (arg.StartsWith(CommandLineOption + "=", StringComparison.OrdinalIgnoreCase))
+            {
+                yield return (arg[(CommandLineOption.Length + 1)..], "command line");
+            }
+            else if (arg.Equals(CommandLineOption, StringComparison.OrdinalIgnoreCase) && i + 1 < args.Length)
+            {
+                yield return (args[i + 1], "command line");
+            }
+        }
+
+        yield return (Environment.GetEnvironmentVariable(EnvironmentVariable), "environment");
+
+        yield return (ReadConfigFile(), "config file " + ConfigFileName);
+
+        foreach (string candidate in ProbeCandidates())
+        {
+            yield return (candidate, "probe");
+        }
+    }
+
+
+    /// <summary>Known Starward-family user data folders, most likely first.</summary>
+    private static IEnumerable<string> ProbeCandidates()
+    {
+        string localAppData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+
+        // upstream default location (holds a database only for non-portable installs)
+        yield return Path.Combine(localAppData, "Starward");
+
+        // portable installs: <drive>:\Mihoyo\Starward is where the official portable build lives
+        foreach (string drive in FixedDrives())
+        {
+            yield return Path.Combine(drive, "Mihoyo", "Starward");
+        }
+
+        // the data folder used by the previous standalone gacha build (MihoyoWishBook)
+        yield return Path.Combine(localAppData, "MihoyoWishBook");
+
+        foreach (string drive in FixedDrives())
+        {
+            yield return Path.Combine(drive, "Starward");
+        }
+
+        // next to the executable (portable-in-place)
+        yield return AppContext.BaseDirectory.TrimEnd(Path.DirectorySeparatorChar);
+    }
+
+
+    private static IEnumerable<string> FixedDrives()
+    {
+        DriveInfo[] drives;
+        try
+        {
+            drives = DriveInfo.GetDrives();
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine($"GachaOnlyDataFolder: enumerate drives failed: {ex.Message}");
+            yield break;
+        }
+        foreach (DriveInfo drive in drives)
+        {
+            if (drive.DriveType == DriveType.Fixed && drive.IsReady)
+            {
+                yield return drive.RootDirectory.FullName;
+            }
+        }
+    }
+
+
+    private static string? ReadConfigFile()
+    {
+        foreach (string file in ConfigFileCandidates())
+        {
+            string? value = ReadConfigValue(file);
+            if (value is not null)
+            {
+                return value;
+            }
+        }
+        return null;
+    }
+
+
+    /// <summary>
+    /// Where the config file may live. Besides the folder next to the executable this checks the
+    /// package root, because in the portable layout the launcher sits in the package root while the
+    /// app runs from <c>app-&lt;version&gt;\</c>, and the config belongs next to the launcher.
+    /// </summary>
+    private static IEnumerable<string> ConfigFileCandidates()
+    {
+        string baseFolder = AppContext.BaseDirectory.TrimEnd(Path.DirectorySeparatorChar);
+        yield return Path.Combine(baseFolder, ConfigFileName);
+
+        var directory = new DirectoryInfo(baseFolder);
+        if (directory.Name.StartsWith("app-", StringComparison.OrdinalIgnoreCase) && directory.Parent is not null)
+        {
+            yield return Path.Combine(directory.Parent.FullName, ConfigFileName);
+        }
+    }
+
+
+    private static string? ReadConfigValue(string file)
+    {
+        try
+        {
+            if (!File.Exists(file))
+            {
+                return null;
+            }
+            foreach (string raw in File.ReadAllLines(file))
+            {
+                string line = raw.Trim();
+                if (line.Length == 0 || line.StartsWith(';') || line.StartsWith('#'))
+                {
+                    continue;
+                }
+                int index = line.IndexOf('=');
+                if (index <= 0)
+                {
+                    continue;
+                }
+                if (line[..index].Trim().Equals(UserDataFolderKey, StringComparison.OrdinalIgnoreCase))
+                {
+                    return line[(index + 1)..].Trim().Trim('"').Trim();
+                }
+            }
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine($"GachaOnlyDataFolder: read {ConfigFileName} failed: {ex.Message}");
+        }
+        return null;
+    }
+
+
+    /// <summary>Expands environment variables, strips quotes and makes the path absolute.</summary>
+    private static string Normalize(string path)
+    {
+        path = Environment.ExpandEnvironmentVariables(path.Trim().Trim('"').Trim());
+        try
+        {
+            return Path.GetFullPath(path);
+        }
+        catch (Exception)
+        {
+            return path;
+        }
+    }
+
+
+    /// <summary>
+    /// Breadcrumb in the (shared) log folder: which folder the app attached to, and which
+    /// candidates were rejected. Purely diagnostic, keeps support questions answerable.
+    /// </summary>
+    private static void WriteBreadcrumb(List<string> tried, string? accepted, string? source)
+    {
+        try
+        {
+            string folder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Starward", "log");
+            Directory.CreateDirectory(folder);
+            string file = Path.Combine(folder, LogFileName);
+            var info = new FileInfo(file);
+            if (info.Exists && info.Length > 64 * 1024)
+            {
+                File.Delete(file);
+            }
+            var lines = new List<string>
+            {
+                $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] {(accepted is null ? "no shared folder resolved, upstream resolution is used" : $"data folder = {accepted}  (from {source})")}",
+            };
+            lines.AddRange(tried.Select(x => "    tried " + x));
+            File.AppendAllLines(file, lines);
+        }
+        catch (Exception ex)
+        {
+            Debug.WriteLine($"GachaOnlyDataFolder: breadcrumb failed: {ex.Message}");
+        }
+    }
+
+}
diff --git a/src/Starward/Features/GachaOnly/GachaOnlyProfile.cs b/src/Starward/Features/GachaOnly/GachaOnlyProfile.cs
new file mode 100644
index 0000000..d3de4e1
--- /dev/null
+++ b/src/Starward/Features/GachaOnly/GachaOnlyProfile.cs
@@ -0,0 +1,63 @@
+// GachaOnly fork — single switch controlling every behavioural difference from upstream Starward.
+//
+// Rules for keeping `git rebase upstream/main` cheap:
+//   * upstream files receive at most one hook line each, and the hook reads `GachaOnlyProfile.Enabled`;
+//   * all logic lives in this folder (Features/GachaOnly), never inside Features/Gacha/**;
+//   * `Enabled` is a static readonly field, not a const, so the upstream build still compiles every
+//     code path (no CS0162 unreachable warnings) and behaves exactly like upstream.
+//
+// This file is new in the fork; upstream never touches it, so it can never conflict.
+
+using Starward.Features.GameLauncher;
+using Starward.Features.ViewHost;
+using System;
+
+namespace Starward.Features.Gacha;
+
+internal static class GachaOnlyProfile
+{
+
+    /// <summary>
+    /// True for the standalone gacha-record build (<c>-p:GachaOnly=true</c>, the project default),
+    /// false for a plain Starward build of the same source tree (<c>-p:GachaOnly=false</c>).
+    /// The constant is generated by the project file (see the GenerateGachaOnlyMarker target) rather
+    /// than taken from DefineConstants, because a command line <c>-p:DefineConstants=...</c> is a
+    /// *global* MSBuild property and silently wins over anything the project appends — upstream's own
+    /// CI passes <c>-p:DefineConstants=DONOT_CHECK_UPDATE</c>, which used to drop our switch and ship
+    /// stock Starward branded as the gacha app. A generated const also survives the Release trimming.
+    /// </summary>
+    public static readonly bool Enabled = GachaOnlyMarker.Enabled;
+
+
+    /// <summary>
+    /// Human readable product name, used in window titles, logs and diagnostics.
+    /// </summary>
+    public static string ProductName => Enabled ? "Starward Gacha" : "Starward";
+
+
+    /// <summary>
+    /// The page MainView falls back to: upstream jumps to the game launcher, the gacha build jumps
+    /// to the gacha record page (or to the "this game has no gacha record" notice page).
+    /// </summary>
+    public static Type GetFallbackPage(GameFeatureConfig? config)
+    {
+        if (!Enabled)
+        {
+            return typeof(GameLauncherPage);
+        }
+        if (config is null)
+        {
+            return typeof(BlankPage);
+        }
+        if (config.SupportedPages.Contains(nameof(GachaLogPage)))
+        {
+            return typeof(GachaLogPage);
+        }
+        if (config.SupportedPages.Contains(nameof(GenshinBeyondGachaPage)))
+        {
+            return typeof(GenshinBeyondGachaPage);
+        }
+        return typeof(GachaOnlyUnsupportedPage);
+    }
+
+}
