+- `CloseWindowOption=Hide` 时关窗仍会最小化到托盘（只禁用了 `--hide` 启动分支）。想彻底不要托盘，
+  需要在 `MainWindow`/`SystemTrayWindow` 里再挂钩。
+- 启动器/截图/工具箱/账号记录等页面仍在程序里（只是不可达），符合「不在意体积」的取舍；
+  将来若要瘦身，是「在 `GachaOnlyProfile` 开关下逐目录裁剪」，不必重写。
+- 未改名命名空间、未改 `RootNamespace`，所以日志/异常里的类型名仍是 `Starward.*`（刻意为之，利于合并）。
+- 若要对外发布：需保留上游 MIT 许可与署名，并按自己的版本号管理（本 fork 已禁用上游更新检查）。
diff --git a/gacha-fork/build.ps1 b/gacha-fork/build.ps1
new file mode 100644
index 0000000..b9e8928
--- /dev/null
+++ b/gacha-fork/build.ps1
@@ -0,0 +1,86 @@
+# GachaOnly fork — build the standalone gacha app from this source tree.
+#
+#   .\build.ps1                                   # Debug-free Release publish, x64
+#   .\build.ps1 -Architecture arm64 -Version 0.2.0
+#   .\build.ps1 -DataFolder 'D:\Starward'         # point the app at a specific data folder
+#   .\build.ps1 -Stock                             # build plain upstream Starward instead
+#
+# Output: <repo>\gacha-fork\out\StarwardGacha-<Version>-<Architecture>\
+#         Starward.GachaOnly.exe + gacha-data.ini (shared user data folder)
+
+param(
+    [string] $Configuration = 'Release',
+    [ValidateSet('x64', 'x86', 'arm64')]
+    [string] $Architecture = 'x64',
+    [string] $Version = '0.1.0',
+    [string] $Output,
+    [string] $DataFolder,
+    [switch] $Stock,
+    [switch] $UseWindowsSdk,
+    [switch] $NoRestore
+)
+
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path -Parent $PSScriptRoot
+
+# The .NET SDK lives outside PATH on this machine (dotnet.exe found no SDK by default).
+$dotnet = 'E:\A-Dev\deepseek-harness\.dotnet\dotnet.exe'
+if (-not (Test-Path $dotnet)) { $dotnet = 'dotnet' }
+$env:DOTNET_ROOT = Split-Path -Parent $dotnet
+$env:DOTNET_CLI_TELEMETRY_OPTOUT = '1'
+$env:DOTNET_NOLOGO = '1'
+
+if (-not $Output) { $Output = Join-Path $PSScriptRoot "out\StarwardGacha-$Version-$Architecture" }
+$runtime = "win-$Architecture"
+
+$props = @("-p:Platform=$Architecture", "-p:Version=$Version", "-p:GachaOnly=$((-not $Stock).ToString().ToLower())")
+if ($UseWindowsSdk) {
+    $props += '-p:WindowsSdkAvailable=true'
+}
+else {
+    # No Windows SDK on this machine: the CsWinRT projection / AOT optimizer steps cannot run, and a
+    # trimmed Release build then dies at XAML startup (0xC000027B). Turn trimming and R2R off.
+    # Command line beats the publish profile, which is what sets PublishTrimmed/PublishReadyToRun.
+    $props += '-p:PublishTrimmed=false'
+    $props += '-p:PublishReadyToRun=false'
+}
+if ($NoRestore) { $props += '--no-restore' }
+
+Write-Host "dotnet      : $dotnet"
+Write-Host "runtime     : $runtime   configuration: $Configuration"
+Write-Host "variant     : $(if ($Stock) { 'stock Starward (GachaOnly=false)' } else { 'GachaOnly (GachaOnly=true)' })"
+Write-Host "output      : $Output"
+Write-Host ''
+
+& $dotnet publish (Join-Path $repo 'src\Starward\Starward.csproj') `
+    -c $Configuration -r $runtime -o $Output @props
+if ($LASTEXITCODE -ne 0) { throw "publish failed with exit code $LASTEXITCODE" }
+
+if (-not $Stock) {
+    $ini = Join-Path $Output 'gacha-data.ini'
+    if ($DataFolder) {
+        $lines = @(
+            '; Starward Gacha - shared user data folder (holds StarwardDatabase.db).'
+            '; resolution order: --data-folder > STARWARD_GACHA_DATA_FOLDER env var > this file > auto probe.'
+            "UserDataFolder=$DataFolder"
+        )
+        Write-Host "data folder : $DataFolder   (written to $ini)"
+    }
+    else {
+        $lines = @(
+            '; Starward Gacha - shared user data folder (holds StarwardDatabase.db).'
+            '; leave the value empty to auto-detect a Starward-family data folder, or set it explicitly,'
+            '; for example:  UserDataFolder=D:\Starward'
+            'UserDataFolder='
+        )
+        Write-Host 'data folder : auto-detect'
+    }
+    # ASCII + no BOM: keeps the file readable whatever writes/reads it next
+    [System.IO.File]::WriteAllLines($ini, $lines, (New-Object System.Text.UTF8Encoding($false)))
+}
+
+$exe = Get-ChildItem $Output -Filter '*.exe' | Where-Object { $_.Name -like 'Starward*' } | Select-Object -First 1
+if ($exe) {
+    Write-Host ''
+    Write-Host "built: $($exe.FullName)  ($([math]::Round($exe.Length / 1MB, 2)) MB)"
+}
diff --git a/gacha-fork/launcher/Program.cs b/gacha-fork/launcher/Program.cs
new file mode 100644
index 0000000..8c3fd4a
--- /dev/null
+++ b/gacha-fork/launcher/Program.cs
@@ -0,0 +1,114 @@
+// GachaOnly fork — portable-package launcher.
+//
+// Mirrors upstream's src/Starward.Launcher (C++): read version.ini, start
+// app-<version>\Starward.exe with the same command line, then delete any other app-* folder that an
+// in-place update left behind. The C++ project cannot be built on a machine without the MSVC
+// toolchain, hence this equivalent.
+//
+// Not part of Starward.slnx, so upstream merges never see it.
+
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+
+const uint MB_OKCANCEL = 0x00000001;
+const uint MB_ICONWARNING = 0x00000030;
+const int IDOK = 1;
+
+[DllImport("user32.dll", CharSet = CharSet.Unicode)]
+static extern int MessageBoxW(IntPtr hWnd, string text, string caption, uint type);
+
+[DllImport("user32.dll")]
+static extern bool SetProcessDPIAware();
+
+[DllImport("shell32.dll", CharSet = CharSet.Unicode)]
+static extern IntPtr ShellExecuteW(IntPtr hwnd, string? op, string file, string? parameters, string? directory, int showCmd);
+
+string baseFolder = Path.GetDirectoryName(Environment.ProcessPath ?? AppContext.BaseDirectory)!;
+string? runExe = null;
+
+// 1) version.ini -> app-<version>\Starward.exe
+string versionFile = Path.Combine(baseFolder, "version.ini");
+if (File.Exists(versionFile))
+{
+    string? version = ReadIniValue(versionFile, "version");
+    if (!string.IsNullOrWhiteSpace(version))
+    {
+        string candidate = Path.Combine(baseFolder, "app-" + version, "Starward.exe");
+        if (File.Exists(candidate))
+        {
+            runExe = candidate;
+        }
+    }
+}
+
+// 2) otherwise the newest Starward*.exe under any app-* folder — a packaged build ships
+//    app-<version>\Starward.exe, a development one Starward.GachaOnly.exe
+if (runExe is null)
+{
+    runExe = Directory.EnumerateDirectories(baseFolder, "app-*")
+                     .SelectMany(dir => Directory.EnumerateFiles(dir, "Starward*.exe"))
+                     .Where(file => Path.GetFileName(file) is "Starward.exe" or "Starward.GachaOnly.exe")
+                     .OrderByDescending(File.GetLastWriteTimeUtc)
+                     .FirstOrDefault();
+}
+
+if (runExe is not null)
+{
+    var startInfo = new ProcessStartInfo
+    {
+        FileName = runExe,
+        WorkingDirectory = Path.GetDirectoryName(runExe)!,
+        UseShellExecute = false,
+    };
+    foreach (string arg in Environment.GetCommandLineArgs().Skip(1))
+    {
+        startInfo.ArgumentList.Add(arg);
+    }
+    Process.Start(startInfo);
+
+    // drop the app folders an in-place update superseded
+    string current = Path.GetFileName(Path.GetDirectoryName(runExe)!);
+    foreach (string dir in Directory.EnumerateDirectories(baseFolder, "app-*"))
+    {
+        if (!string.Equals(Path.GetFileName(dir), current, StringComparison.OrdinalIgnoreCase))
+        {
+            try
+            {
+                Directory.Delete(dir, true);
+            }
+            catch (Exception)
+            {
+                // a running or read-only folder is not worth failing the launch over
+            }
+        }
+    }
+}
+else
+{
+    SetProcessDPIAware();
+    const string url = "https://github.com/Scighost/Starward";
+    int choice = MessageBoxW(IntPtr.Zero,
+                             $"Starward files not found.\r\nWould you like to visit the project page?\r\n{url}",
+                             "Starward Gacha",
+                             MB_ICONWARNING | MB_OKCANCEL);
+    if (choice == IDOK)
+    {
+        ShellExecuteW(IntPtr.Zero, null, url, null, null, 1);
+    }
+}
+
+
+static string? ReadIniValue(string path, string key)
+{
+    // version.ini only ever holds one global key, so a full INI parser is not needed
+    foreach (string raw in File.ReadAllLines(path))
+    {
+        string line = raw.Trim();
+        int separator = line.IndexOf('=');
+        if (separator > 0 && line[..separator].Trim().Equals(key, StringComparison.OrdinalIgnoreCase))
+        {
+            return line[(separator + 1)..].Trim();
+        }
+    }
+    return null;
+}
diff --git a/gacha-fork/launcher/StarwardGacha.Launcher.csproj b/gacha-fork/launcher/StarwardGacha.Launcher.csproj
new file mode 100644
index 0000000..60fa14d
--- /dev/null
+++ b/gacha-fork/launcher/StarwardGacha.Launcher.csproj
@@ -0,0 +1,32 @@
+<Project Sdk="Microsoft.NET.Sdk">
+
+  <!--  GachaOnly fork: portable-package launcher, the C# equivalent of upstream's
+        src/Starward.Launcher (C++). It exists so the release keeps the same shape as Starward's
+        own portable package:
+
+            Starward.exe     <- this launcher
+            version.ini      <- version=<version>
+            app-<version>\   <- the actual app (published with -p:AssemblyName=Starward)
+
+        The upstream launcher is a vcxproj and needs the MSVC toolchain, which the build machine
+        does not have, so the behaviour is reimplemented here.  -->
+
+  <PropertyGroup>
+    <OutputType>WinExe</OutputType>
+    <TargetFramework>net10.0</TargetFramework>
+    <Nullable>enable</Nullable>
+    <ImplicitUsings>enable</ImplicitUsings>
+    <AssemblyName>Starward</AssemblyName>
+    <RootNamespace>Starward.Launcher</RootNamespace>
+    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
+    <SelfContained>true</SelfContained>
+    <PublishSingleFile>true</PublishSingleFile>
+    <!-- the launcher is plain BCL code, so trimming is safe here (unlike the XAML app) -->
+    <PublishTrimmed>true</PublishTrimmed>
+    <PublishReadyToRun>false</PublishReadyToRun>
+    <InvariantGlobalization>true</InvariantGlobalization>
+    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
+    <DebugType>none</DebugType>
+  </PropertyGroup>
+
+</Project>
diff --git a/gacha-fork/package.ps1 b/gacha-fork/package.ps1
new file mode 100644
index 0000000..6823715
--- /dev/null
+++ b/gacha-fork/package.ps1
@@ -0,0 +1,140 @@
+# GachaOnly fork — package the source tree and the portable release.
+#
+#   .\package.ps1 -Version 0.1.0                     # both archives
+#   .\package.ps1 -Version 0.1.0 -DataFolder 'F:\Mihoyo\Starward'
+#   .\package.ps1 -Version 0.1.0 -SkipBuild -SkipSource
+#
+# The release archive keeps the layout of Starward's own portable package:
+#
+#   StarwardGacha/
+#       Starward.exe          launcher (gacha-fork/launcher, the C# equivalent of upstream's C++ one)
+#       version.ini           version=<version>
+#       app-<version>/        the published app (AssemblyName forced to Starward, as upstream does)
+#       gacha-data.ini        only when -DataFolder is given (shared data folder, see README §3)
+#
+# Output: gacha-fork/dist/
+#   StarwardGacha_Portable_<version>_x64.zip
+#   StarwardGacha_Source_<version>.zip
+#
+# Note: this machine's execution policy refuses to run .ps1 directly, so invoke it as
+#   powershell.exe -ExecutionPolicy Bypass -File gacha-fork\package.ps1 -Version 0.1.0
+
+param(
+    [Parameter(Mandatory = $true)][string] $Version,
+    [string] $Architecture = 'x64',
+    [string] $DataFolder = '',
+    [switch] $SkipBuild,
+    [switch] $SkipSource
+)
+
+$ErrorActionPreference = 'Stop'
+$forkRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
+$repoRoot = Split-Path -Parent $forkRoot
+$dist = Join-Path $forkRoot 'dist'
+$stage = Join-Path $dist 'stage'
+$packageName = 'StarwardGacha'
+$packageRoot = Join-Path $stage $packageName
+$appFolder = Join-Path $packageRoot "app-$Version"
+$dotnet = if ($env:DOTNET_ROOT) { Join-Path $env:DOTNET_ROOT 'dotnet.exe' } else { 'dotnet' }
+
+if (-not (Test-Path $dotnet)) { $dotnet = 'dotnet' }
+
+Write-Output "[1/5] cleaning stage"
+if (-not $SkipBuild) {
+    if (Test-Path $stage) { Remove-Item $stage -Recurse -Force }
+    New-Item -ItemType Directory -Path $packageRoot -Force | Out-Null
+
+    Write-Output "[2/5] launcher -> $packageRoot\Starward.exe"
+    & $dotnet publish (Join-Path $forkRoot 'launcher\StarwardGacha.Launcher.csproj') `
+        -c Release -r "win-$Architecture" -o (Join-Path $stage 'launcher') `
+        -p:Version=$Version -v m
+    if ($LASTEXITCODE -ne 0) { throw 'launcher publish failed' }
+    Move-Item (Join-Path $stage 'launcher\Starward.exe') (Join-Path $packageRoot 'Starward.exe') -Force
+    Remove-Item (Join-Path $stage 'launcher') -Recurse -Force
+
+    Write-Output "[3/5] app -> $appFolder"
+    # The app project already publishes as app-<version>\Starward.exe when GachaOnly is on (see the
+    # AssemblyName note in Starward.csproj), which is the name both this fork's launcher and
+    # upstream's C++ launcher start. Trimming/ReadyToRun are decided by the project as well.
+    & $dotnet publish (Join-Path $repoRoot 'src\Starward\Starward.csproj') `
+        -c Release -r "win-$Architecture" -p:Platform=$Architecture -p:Version=$Version `
+        -p:GachaOnly=true -o $appFolder -v m
+    if ($LASTEXITCODE -ne 0) { throw 'app publish failed' }
+
+    Write-Output "[4/5] version.ini"
+    Set-Content -Path (Join-Path $packageRoot 'version.ini') -Value "version=$Version" -Encoding ascii
+    if ($DataFolder) {
+        Set-Content -Path (Join-Path $packageRoot 'gacha-data.ini') -Value "UserDataFolder=$DataFolder" -Encoding ascii
+    }
+}
+else {
+    Write-Output "[1/5..4/5] build skipped"
+}
+
+Write-Output "[5/5] archives"
+New-Item -ItemType Directory -Path $dist -Force | Out-Null
+
+# --- portable package -------------------------------------------------------------------------
+if (Test-Path (Join-Path $packageRoot 'Starward.exe')) {
+    $portableArchive = Join-Path $dist "StarwardGacha_Portable_${Version}_$Architecture.zip"
+    Remove-Item $portableArchive -Force -ErrorAction SilentlyContinue
+    Push-Location $stage
+    try { tar -c -a -f $portableArchive $packageName } finally { Pop-Location }
+}
+else {
+    Write-Output '  portable package skipped (no stage; run without -SkipBuild)'
+}
+
+# --- source package ---------------------------------------------------------------------------
+# The tracked tree (upstream + the fork's code changes) plus the fork folder itself, which is kept
+# out of git on purpose. Build output (dist/out/backup/bin/obj) never goes in.
+if (-not $SkipSource) {
+    $sourceArchive = Join-Path $dist "StarwardGacha_Source_$Version.zip"
+    Remove-Item $sourceArchive -Force -ErrorAction SilentlyContinue
+    $sourceStage = Join-Path $dist 'srcstage'
+    if (Test-Path $sourceStage) { Remove-Item $sourceStage -Recurse -Force }
+    New-Item -ItemType Directory -Path $sourceStage -Force | Out-Null
+
+    git -C $repoRoot archive --format=zip -o (Join-Path $dist 'tracked.zip') HEAD
+    if ($LASTEXITCODE -ne 0) { throw 'git archive failed' }
+    Expand-Archive -Path (Join-Path $dist 'tracked.zip') -DestinationPath $sourceStage -Force
+    Remove-Item (Join-Path $dist 'tracked.zip') -Force
+
+    $forkTarget = Join-Path $sourceStage 'gacha-fork'
+    New-Item -ItemType Directory -Path $forkTarget -Force | Out-Null
+    foreach ($item in 'README.md', 'build.ps1', 'package.ps1', 'sync-upstream.ps1', 'tools', 'gacha-only.patch', 'gacha-only.diff') {
+        $source = Join-Path $forkRoot $item
+        if (Test-Path $source) { Copy-Item $source -Destination $forkTarget -Recurse -Force }
+    }
+    # the launcher project: sources only, never its build output
+    $launcherSource = Join-Path $forkRoot 'launcher'
+    if (Test-Path $launcherSource) {
+        $launcherTarget = Join-Path $forkTarget 'launcher'
+        New-Item -ItemType Directory -Path $launcherTarget -Force | Out-Null
+        Copy-Item (Join-Path $launcherSource '*.*') -Destination $launcherTarget -Force
+    }
+    # belt and braces: nothing built ever ships in the source package
+    Get-ChildItem $sourceStage -Recurse -Directory | Where-Object { $_.Name -in 'bin', 'obj' } |
+        Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
+
+    # The archive should read as "Starward Gacha", not as a stock Starward drop: the package README
+    # becomes the entry point and upstream's own README is kept beside it.
+    $upstreamReadme = Join-Path $sourceStage 'README.md'
+    if (Test-Path $upstreamReadme) {
+        Move-Item $upstreamReadme (Join-Path $sourceStage 'README.upstream.md') -Force
+    }
+    $packageReadme = Join-Path $forkRoot 'PACKAGE-README.md'
+    if (Test-Path $packageReadme) {
+        Copy-Item $packageReadme (Join-Path $sourceStage 'README.md') -Force
+    }
+
+    Push-Location $sourceStage
+    try { tar -c -a -f $sourceArchive (Get-ChildItem $sourceStage | Select-Object -ExpandProperty Name) } finally { Pop-Location }
+    Remove-Item $sourceStage -Recurse -Force
+}
+
+Remove-Item $stage -Recurse -Force -ErrorAction SilentlyContinue
+
+Get-ChildItem $dist -File | ForEach-Object {
+    Write-Output ("  {0}  {1:N1} MB" -f $_.Name, ($_.Length / 1MB))
+}
diff --git a/gacha-fork/sync-upstream.ps1 b/gacha-fork/sync-upstream.ps1
new file mode 100644
index 0000000..adaad36
--- /dev/null
+++ b/gacha-fork/sync-upstream.ps1
@@ -0,0 +1,71 @@
+# Sync this fork with upstream Starward.
+#
+#   .\sync-upstream.ps1              # fetch + rebase the fork commit(s) onto upstream/main
+#   .\sync-upstream.ps1 -Merge       # same, but merge instead of rebase
+#   .\sync-upstream.ps1 -Check       # only show what would conflict (no history rewrite)
+#
+# The whole fork is meant to stay a thin patch on top of upstream:
+#   6 upstream files with one hook line each, everything else in new files
+#   (src/Starward/Features/GachaOnly/**, src/Starward.Core/HoYoPlay/HoYoPlayClientLegacyOverloads.cs).
+# If upstream touches those hook lines, the conflict is one or two lines wide.
+
+param(
+    [string] $UpstreamUrl = 'https://github.com/Scighost/Starward.git',
+    [string] $Branch = 'main',
+    [switch] $Merge,
+    [switch] $Check
+)
+
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path -Parent $PSScriptRoot
+Push-Location $repo
+try {
+    $remotes = git remote
+    if ($remotes -notcontains 'upstream') {
+        Write-Host "adding remote upstream -> $UpstreamUrl"
+        git remote add upstream $UpstreamUrl
+    }
+
+    Write-Host 'fetching upstream...'
+    git fetch upstream $Branch --tags
+    if ($LASTEXITCODE -ne 0) { throw 'git fetch failed (no network access to GitHub?)' }
+
+    $ahead = (git rev-list --count "upstream/$Branch..HEAD")
+    $behind = (git rev-list --count "HEAD..upstream/$Branch")
+    Write-Host "fork is $ahead commit(s) ahead, $behind commit(s) behind upstream/$Branch"
+    if ($ahead -eq 0) { Write-Warning 'fork has no own commits: nothing to sync' }
+
+    Write-Host ''
+    Write-Host 'files this fork patches (the only places a conflict can appear):'
+    git diff --name-status "upstream/$Branch...HEAD" -- src | ForEach-Object { "  $_" }
+
+    if ($Check) {
+        Write-Host ''
+        Write-Host 'dry run (git merge-tree):'
+        git merge-tree --write-tree "upstream/$Branch" HEAD | Select-Object -First 40
+        return
+    }
+
+    Write-Host ''
+    if ($Merge) {
+        Write-Host "merging upstream/$Branch into the fork..."
+        git merge "upstream/$Branch"
+    }
+    else {
+        Write-Host "rebasing the fork commit(s) onto upstream/$Branch..."
+        git rebase "upstream/$Branch"
+    }
+
+    if ($LASTEXITCODE -ne 0) {
+        Write-Warning 'conflicts need resolving, then run:  git rebase --continue   (or git merge --continue)'
+        git diff --name-only --diff-filter=U | ForEach-Object { "  conflict: $_" }
+        Write-Host ''
+        Write-Host 'reminder: never rename namespaces/files or move Features/Gacha/** — that is what keeps this cheap.'
+        return
+    }
+
+    Write-Host 'synced. now rebuild:  .\build.ps1 -DataFolder <your data folder>'
+}
+finally {
+    Pop-Location
+}
diff --git a/gacha-fork/tools/check_weapon_pool.py b/gacha-fork/tools/check_weapon_pool.py
new file mode 100644
index 0000000..3aaead9
--- /dev/null
+++ b/gacha-fork/tools/check_weapon_pool.py
@@ -0,0 +1,58 @@
+import sqlite3
+import sys
+
+db = sys.argv[1] if len(sys.argv) > 1 else r"C:\Users\tang\AppData\Local\MihoyoWishBook\StarwardDatabase.db"
+out = sys.argv[2] if len(sys.argv) > 2 else "weapon-check.txt"
+c = sqlite3.connect(db)
+
+STANDARD_WEAPONS = {
+    "天空之刃", "天空之傲", "天空之翼", "天空之卷", "天空之脊",
+    "狼的末路", "四风原典", "阿莫斯之弓", "和璞鸢", "风鹰剑",
+}
+STANDARD_CHARS = {"迪卢克", "琴", "莫娜", "七七", "刻晴", "提纳里", "迪希雅", "梦见月瑞希"}
+STANDARD = STANDARD_WEAPONS | STANDARD_CHARS
+
+lines = []
+
+
+def five(uid, gtype):
+    return c.execute(
+        "SELECT Id, Name FROM GenshinGachaItem WHERE Uid=? AND RankType=5 AND GachaType=? ORDER BY Id;",
+        (uid, gtype),
+    ).fetchall()
+
+
+def report(seq, standard, label):
+    off = [n for _, n in seq if n in standard]
+    flips = wins = 0
+    prev_up = None
+    for _, n in seq:
+        up = n not in standard
+        if prev_up is None or prev_up is True:
+            flips += 1
+            if up:
+                wins += 1
+        prev_up = up
+    lines.append(f"{label}: n={len(seq)} up={len(seq) - len(off)} off={len(off)} "
+                 f"flips={flips} wins={wins} rate={(wins / flips if flips else 0):.1%}")
+    lines.append(f"    off-banner items: {off}")
+
+
+uid = 110369802
+perm = five(uid, 200)
+derived = {n for _, n in perm}
+lines.append(f"permanent 5★ distinct ({len(derived)}): {sorted(derived)}")
+lines.append(f"standard weapons missing from the permanent pull list: {sorted(STANDARD_WEAPONS - derived)}")
+lines.append("")
+
+weapon = five(uid, 302)
+report(weapon, STANDARD, "weapon banner / hardcoded standard pool")
+report(weapon, derived, "weapon banner / pool derived from permanent pulls")
+lines.append("")
+chars = five(uid, 301)
+report(chars, STANDARD_CHARS, "character banner / hardcoded standard characters")
+report(chars, derived, "character banner / pool derived from permanent pulls")
+
+with open(out, "w", encoding="utf-8") as fh:
+    fh.write("\n".join(lines) + "\n")
+print("written", out)
